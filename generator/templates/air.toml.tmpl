root = "."
tmp_dir = "tmp"

[build]
cmd = "go build -o ./tmp/main.exe ./cmd/main.go"
bin = "tmp/main.exe"
full_bin = ""
include_ext = ["go", "tpl", "tmpl", "html", "yaml", "yml", "json"]
exclude_dir = ["tmp", "vendor", "testdata"]
delay = 1000
stop_on_error = true
send_interrupt = false
kill_delay = 500

[log]
time = true
