root = "."
tmp_dir = "tmp"

[build]
cmd = "go build -o ./tmp/main ./cmd/main.go"
bin = "tmp/main"
full_bin = ""
include_dir = ["cmd", "internal", "pkg", "api"]
include_ext = ["go", "tpl", "tmpl", "html"]
exclude_dir = ["tmp", "vendor", "testdata", "graphify-out"]
exclude_unchanged = true
delay = 1000
stop_on_error = true
send_interrupt = true
kill_delay = 500

[log]
time = true
