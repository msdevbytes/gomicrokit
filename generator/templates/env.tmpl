APP_NAME="{{.ProjectName}}"
APP_ENV=dev
PORT={{.Port}}
HOST=localhost


API_ROUTE_VERSION=/api/v1
APP_BASE_PATH=

#if yes will drop all tables and re created them
FORCE_MIGRATE=no

CACHE_CLIENT=
CACHE_STORE={{if .HasCache}}{{.CacheStore}}{{else}}none{{end}}
#
{{ if eq .DBType "postgres" }}
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_NAME={{.DBName}}
DB_PORT=5432
# host port published by docker compose (defaults to 5432 if unset)
DB_PORT_FORWARD=5432
{{ else if eq .DBType "sqlite" }}
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME={{.DBName}}.db
DB_PORT=
{{ else if eq .DBType "none" }}
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
DB_PORT=
{{ else }}
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_NAME={{.DBName}}
DB_PORT=3306
# host port published by docker compose (defaults to 3306 if unset)
DB_PORT_FORWARD=3306
{{ end }}
# #


REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# startup/runtime
SHUTDOWN_TIMEOUT=10s

# messaging
NATS_URL=nats://127.0.0.1:4222

# observability
{{ if and .HasOTel .WithDocker }}
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
{{ else }}
OTEL_EXPORTER_OTLP_ENDPOINT=
{{ end }}

# discovery
DISCOVERY_PROVIDER=none
CONSUL_ADDRESS=127.0.0.1:8500
SERVICE_NAME={{.ProjectName}}
SERVICE_ID=
SERVICE_HOST=127.0.0.1
SERVICE_TAGS={{if eq .ProjectType "grpc"}}grpc{{else}}rest{{end}}

AUTH_HEADER=x-api-key
API_KEY={{if .HasAuth}}change-me-in-prod{{else}}{{end}}
ENABLE_AUTH={{if .HasAuth}}yes{{else}}no{{end}}
ENABLE_CONFIG={{if .HasConfig}}yes{{else}}no{{end}}
ENABLE_DISCOVERY={{if .HasDiscovery}}yes{{else}}no{{end}}
ENABLE_MESSAGING={{if .HasMessaging}}yes{{else}}no{{end}}
ENABLE_METRICS={{if .HasMetrics}}yes{{else}}no{{end}}
ENABLE_OTEL={{if .HasOTel}}yes{{else}}no{{end}}
ENABLE_RESILIENCE={{if .HasResilience}}yes{{else}}no{{end}}
ENABLE_TRACING={{if .HasTracing}}yes{{else}}no{{end}}
