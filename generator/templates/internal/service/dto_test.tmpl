package dto_test

import (
	"encoding/json"
	"testing"

	"{{.Module}}/internal/dto"
)

func TestCreate{{.Service}}Input_JSON(t *testing.T) {
	input := dto.Create{{.Service}}Input{
		Name: "Test {{.Service}}",
	}

	data, err := json.Marshal(input)
	if err != nil {
		t.Fatalf("failed to marshal Create{{.Service}}Input: %v", err)
	}

	var decoded dto.Create{{.Service}}Input
	if err := json.Unmarshal(data, &decoded); err != nil {
		t.Fatalf("failed to unmarshal Create{{.Service}}Input: %v", err)
	}

	if decoded.Name != input.Name {
		t.Errorf("expected Name=%q, got %q", input.Name, decoded.Name)
	}
}

