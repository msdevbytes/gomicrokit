package api

import (
	"encoding/json"
	"net/http"
	"os"
	"time"

	"{{.ModulePath}}/internal/handler"
{{- if .HasAuth }}
	"{{.ModulePath}}/internal/middleware"
{{- end }}
	"{{.ModulePath}}/internal/service"

	"github.com/go-chi/chi/v5"
	chiMiddleware "github.com/go-chi/chi/v5/middleware"
)

func Register(svc *service.Container) http.Handler {
	r := chi.NewRouter()
	r.Use(chiMiddleware.RequestID)
	r.Use(chiMiddleware.Recoverer)

	r.Get("/", func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, handler.APIResponse{
			Success: true,
			Message: "Welcome to Service",
			Data:    time.Now().Format(time.RFC3339),
		})
	})
	r.Get("/healthz", func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, handler.APIResponse{
			Success: true,
			Message: "ok",
			Data:    map[string]string{"status": "healthy"},
		})
	})
	r.Get("/readyz", func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, handler.APIResponse{
			Success: true,
			Message: "ready",
			Data:    map[string]string{"status": "ready"},
		})
	})

	basePath := os.Getenv("API_ROUTE_VERSION")
	if basePath == "" {
		basePath = "/api/v1"
	}
	authHeader := os.Getenv("AUTH_HEADER")
	if authHeader == "" {
		authHeader = "x-api-key"
	}
	r.Route(basePath, func(api chi.Router) {
{{- if .HasAuth }}
		api.Use(middleware.RequireAPIKey(authHeader, os.Getenv("API_KEY")))
{{- end }}
		handler.NewDefaultHandler().Register(api)
		// gmk:register-services
{{- if .HasMetrics }}
		handler.NewMetricsHandler().Register(r)
{{- end }}
	})
	return r
}

func writeJSON(w http.ResponseWriter, status int, payload any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(payload)
}
