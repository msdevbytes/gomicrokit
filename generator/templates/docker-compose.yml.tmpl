# Generated by gomicrokit for {{.ProjectName}}.
# Only selected dependencies are included.
#
# Start the full stack with live reload:
#   docker compose up --watch --build
#
# Detached (no live sync):
#   docker compose up -d --build
#
# Infra only (for Air / go run on the host):
#   docker compose up -d mysql redis nats consul otel-collector
#
name: {{.ProjectName}}

services:
{{ if .HasMySQL }}
  mysql:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD:-root}
      MYSQL_DATABASE: ${DB_NAME:-{{.DBName}}}
    ports:
      - "${DB_PORT_FORWARD:-3306}:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-p${DB_PASSWORD:-root}"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 20s
{{ end }}
{{ if .HasPostgres }}
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: ${DB_NAME:-{{.DBName}}}
    ports:
      - "${DB_PORT_FORWARD:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-postgres} -d ${DB_NAME:-{{.DBName}}}"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 10s
{{ end }}
{{ if .HasRedis }}
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
{{ end }}
{{ if .HasMessaging }}
  nats:
    image: nats:2.10-alpine
    restart: unless-stopped
    command: ["-js", "-m", "8222"]
    ports:
      - "4222:4222"
      - "8222:8222"
{{ end }}
{{ if .HasDiscovery }}
  consul:
    image: hashicorp/consul:1.20
    restart: unless-stopped
    command: ["agent", "-dev", "-client=0.0.0.0", "-ui"]
    ports:
      - "8500:8500"
{{ end }}
{{ if .HasOTel }}
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.109.0
    restart: unless-stopped
    command: ["--config=/etc/otel-collector-config.yaml"]
    volumes:
      - ./otel-collector.yaml:/etc/otel-collector-config.yaml:ro
    ports:
      - "4317:4317"
      - "4318:4318"
{{ end }}
  app:
    restart: on-failure
    build:
      context: .
      dockerfile: Dockerfile
      target: dev
      args:
        GO_VERSION: "{{.GoVersion}}"
        PORT: "{{.Port}}"
    working_dir: /src
    volumes:
      - go-mod-cache:/go/pkg/mod
    command: ["air", "-c", ".air.docker.toml"]
    ports:
      - "{{.Port}}:{{.Port}}"
    env_file:
      - .env
    environment:
      HOST: 0.0.0.0
      PORT: "{{.Port}}"
{{ if .HasMySQL }}
      DB_HOST: mysql
{{ else if .HasPostgres }}
      DB_HOST: postgres
{{ end }}
{{ if .HasRedis }}
      REDIS_HOST: redis
{{ end }}
{{ if .HasMessaging }}
      NATS_URL: nats://nats:4222
{{ end }}
{{ if .HasDiscovery }}
      DISCOVERY_PROVIDER: consul
      CONSUL_ADDRESS: consul:8500
      SERVICE_HOST: app
{{ end }}
{{ if .HasOTel }}
      OTEL_EXPORTER_OTLP_ENDPOINT: otel-collector:4317
{{ end }}
{{ if .HasComposeInfra }}
    depends_on:
{{ if .HasMySQL }}
      mysql:
        condition: service_healthy
{{ end }}
{{ if .HasPostgres }}
      postgres:
        condition: service_healthy
{{ end }}
{{ if .HasRedis }}
      redis:
        condition: service_healthy
{{ end }}
{{ if .HasMessaging }}
      nats:
        condition: service_started
{{ end }}
{{ if .HasDiscovery }}
      consul:
        condition: service_started
{{ end }}
{{ if .HasOTel }}
      otel-collector:
        condition: service_started
{{ end }}
{{ end }}
    develop:
      watch:
        - path: ./cmd
          action: sync
          target: /src/cmd
        - path: ./internal
          action: sync
          target: /src/internal
        - path: ./pkg
          action: sync
          target: /src/pkg
{{ if eq .ProjectType "grpc" }}
        - path: ./api
          action: sync
          target: /src/api
{{ end }}
        - path: go.mod
          action: rebuild
        - path: go.sum
          action: rebuild
        - path: .env
          action: restart
        - path: .air.docker.toml
          action: rebuild

volumes:
  go-mod-cache:
{{ if .HasMySQL }}
  mysql_data:
{{ end }}
{{ if .HasPostgres }}
  postgres_data:
{{ end }}
{{ if .HasRedis }}
  redis_data:
{{ end }}
